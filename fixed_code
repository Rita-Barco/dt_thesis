### CONSIDERING THE LOWEST ALTITUTE COORNER OF THE BUILDING ###

def extrude_buildings(footprints, center, dem_src, geoid_src, to_4326_transformer):
    print("Extruding buildings with DEM data...")
    instances_building = []

    for footprint in footprints:
        poly = footprint["geometry"]
        height = footprint["height"]

        # Find exterior coordinates of the building        
        exterior_coords = list(poly.exterior.coords)
        coords_altitude = []

        for coord in exterior_coords:
            get_altitude = get_elevation_at_point(
            coord[0], coord[1], 
            dem_src, geoid_src, to_4326_transformer
        )
            coords_altitude.append(get_altitude)
        
        ground_z = min(coords_altitude)

        # Shift footprint coordinates to local center origin
        coords = np.array(poly.exterior.coords)
        coords[:, 0] -= center[0]
        coords[:, 1] -= center[1]
        
        n_pts = len(coords) - 1
        
        # C. Set the base of the flat building shape to the ground_z value
        points_2d = np.column_stack((coords[:-1], np.full(n_pts, ground_z)))
        faces_2d = np.hstack([[n_pts], list(range(n_pts))])
        
        building_flat = pv.PolyData(points_2d, faces_2d)
        
        # D. Native Z-up extrusion (Height builds up cleanly from the sloped ground)
        building_3d = building_flat.extrude((0, 0, height), capping=True)

        color = generate_random_color()
        building_3d['color'] = np.tile(color, (building_3d.n_points, 1))
        instances_building.append(building_3d)

    # Fast O(N) merge optimization
    city_mesh = pv.merge(instances_building) if instances_building else pv.PolyData()
    city_mesh = city_mesh.triangulate().compute_normals(auto_orient_normals=True)
    return city_mesh, instances_building

def create_tree_meshes(trees, center, dem_src, geoid_src, to_4326_transformer):
    print("Generating tree meshes with DEM data...")
    instances_trees = []

    for _, row in trees.iterrows():
        geom = row.geometry
        if geom is None or geom.geom_type != "Point":
            continue

        # Get absolute ground level from DEM/Geoid mapping
        ground_z = get_elevation_at_point(
            geom.x, geom.y, 
            dem_src, geoid_src, to_4326_transformer
        )

        # Shift to local origin
        x = geom.x - center[0]
        y = geom.y - center[1]

        # Trunk (Base rests at ground_z)
        trunk = pv.Cylinder(
            center=(x, y, ground_z + 1.0),
            direction=(0, 0, 1),
            radius=0.15,
            height=2.0,
            resolution=12
        )

        # Canopy
        canopy = pv.Sphere(
            radius=1.0,
            center=(x, y, ground_z + 3.0),
            theta_resolution=12,
            phi_resolution=12
        )

        instances_trees.append(trunk.merge(canopy))

    tree_mesh = pv.merge(instances_trees) if instances_trees else pv.PolyData()
    return tree_mesh


# EXPORT FUNCTIONS 
def save_to_obj(mesh, output_path):
    output_dir = Path(output_path).parent
    output_dir.mkdir(parents=True, exist_ok=True)
    print(f"Saving model to {output_path}")
    mesh.save(output_path)

def save_to_gltf(mesh, output_path):
    output_dir = Path(output_path).parent
    output_dir.mkdir(parents=True, exist_ok=True)

    # 1. Clone the mesh and fix the axis for glTF (Z-up to Y-up)
    export_mesh = mesh.copy()
    export_mesh.rotate_x(-90, inplace=True)

    # 2. Clean and force strict triangulation
    export_mesh = export_mesh.triangulate().clean()
    faces = export_mesh.faces.reshape((-1, 4))[:, 1:]

    # 3. Create the trimesh object
    tm = trimesh.Trimesh(
        vertices=export_mesh.points,
        faces=faces,
        process=True
    )

    # 4. Define PBR material properties
    material = SimpleMaterial(
        diffuse=[220, 220, 220, 255],  # Clean light gray baseline
        roughness=0.6,
        metallic=0.1,
    )
    tm.visual.material = material

    # 5. FIX THE HOLLOW LOOK: Force double-sided rendering in the glTF material definition
    # This ensures both Cesium and Unreal Engine render the back-faces of polygons.
    if hasattr(tm.visual.material, 'to_color'):
        # Convert SimpleMaterial to a full PBR material assembly that supports glTF extras
        tm.visual.material = tm.visual.material.to_pbr()
    
    # Inject the doubleSided flag into the glTF material structure
    tm.visual.material.doubleSided = True
    
    # 6. Export GLB safely without the illegal kwargs
    tm.export(output_path, include_normals=True)
    print(f"Saved solid GLB to {output_path}")


