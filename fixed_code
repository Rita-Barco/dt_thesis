# EXTRACT DATA
def extract_osm_data_bbox(north, south, east, west):
    bbox = [west, south, east, north]
    print("Downloading OSM data for bounding box...")

    buildings = ox.features_from_bbox(bbox, tags={'building': True})
    trees = ox.features_from_bbox(bbox, tags={'natural': 'tree'})

    # Project to local CRS
    buildings = ox.projection.project_gdf(buildings, to_crs="3763")
    trees = ox.projection.project_gdf(trees, to_crs="3763")

    print(f"Downloaded {len(buildings)} buildings and {len(trees)} trees.")

    minx, miny, maxx, maxy = buildings.total_bounds
    center_x = (minx + maxx) / 2
    center_y = (miny + maxy) / 2

    return buildings, trees, (center_x, center_y)


# GENERATE FOOTPRINTS
def parse_height(value):
    if not value:
        return None
    try:
        return float(str(value).replace("m", "").split(";")[0])
    except:
        return None

def is_missing(value):
    return value is None or (isinstance(value, float) and np.isnan(value))

def generate_footprints(buildings):
    footprints = []
    for _, row in buildings.iterrows():
        geom = row.geometry
        height = parse_height(row.get('height'))
        levels = parse_height(row.get('building:levels'))

        if is_missing(height) and not is_missing(levels):
            height = levels * 3 
        if is_missing(height):
            height = random.uniform(3, 12) # Kept fallback realistic

        def add_poly(poly):
            footprints.append({"geometry": poly, "height": height})

        if isinstance(geom, MultiPolygon):
            for poly in geom.geoms:
                add_poly(poly)
        elif isinstance(geom, Polygon):
            add_poly(geom)

    return footprints


# EXTRUDE BUILDINGS 
def generate_random_color():
    return [random.random() for _ in range(3)]


def get_elevation_at_point(x_3763, y_3763, dem_map, geoid_map, to_4326_transformer):
    # Obtain orthometric altitude using local projected coordinates (x, y)
    alt_orthometric = next(dem_map.sample([(x_3763, y_3763)]))[0]
    
    # Convert EPSG:3763 back to LLA (Lon, Lat) to sample the Geoid map
    lon, lat = to_4326_transformer.transform(x_3763, y_3763)
    
    # Obtain geoid altitude using global coordinates (lon, lat)
    alt_geoid = next(geoid_map.sample([(lon, lat)]))[0]
    
    print(f"MDT: {alt_orthometric:.2f}m | Geoid: {alt_geoid:.2f}m | Total: {alt_orthometric + alt_geoid:.2f}m")
    return alt_orthometric + alt_geoid
    


