# EXTRACT DATA
def extract_osm_data_bbox(north, south, east, west):
    bbox = [west, south, east, north]
    print("Downloading OSM data for bounding box...")

    buildings = ox.features_from_bbox(bbox, tags={'building': True})
    trees = ox.features_from_bbox(bbox, tags={'natural': 'tree'})

    # Project to local CRS
    buildings = ox.projection.project_gdf(buildings, to_crs="3763")
    trees = ox.projection.project_gdf(trees, to_crs="3763")

    print(f"Downloaded {len(buildings)} buildings and {len(trees)} trees.")

    minx, miny, maxx, maxy = buildings.total_bounds
    center_x = (minx + maxx) / 2
    center_y = (miny + maxy) / 2

    return buildings, trees, (center_x, center_y)


# CHECK DEM FILES THAT CONTAIN SELECTED AREA

def select_dem_files(north, south,west,east, dem_dir, output_dem_path):

    # transform selected bounding box to local projection
    transformer = Transformer.from_crs("EPSG:4326", "EPSG:3763", always_xy= True)
    min_x, min_y = transformer.transform(west, south)
    max_x, max_y = transformer.transform(east, north)
    bbox_polygon = box(min_x, min_y, max_x, max_y)

    # select intersecting dem files
    intersecting_files = []
    for path in Path(dem_dir).glob("*.tiff"):
        src = rasterio.open(path)
        print(f"\n--- Checking {path.name} ---")
        print(f"DEM CRS: {src.crs}")
        print(f"DEM Bounds: {src.bounds}")
        print(f"BBOX (EPSG:3763): {bbox_polygon.bounds}")
        dem_poly = box (src.bounds.left, src.bounds.bottom, src.bounds.right, src.bounds.top)

        if bbox_polygon.intersects(dem_poly):
            intersecting_files.append(src)
        else:
            src.close()

    if not intersecting_files:
        raise FileExistsError("No DEM files cover the selected bounding box!")


    # merge selected dem files into a single array (easir to use, instead of iterating through all of them)
    print(f"Merging {len(intersecting_files)} matching DEM tile(s)")
    mosaic_array, out_transform = merge(intersecting_files)

    # copy profile from the first tile and update dimensions and transform
    #when merging multiple DEM files, raterio generates a new NumPY array representing the combined
    #image -> now rasterio needes metadata to turn this raw NUmPy array back into a readable raster dataset

    out_profile = intersecting_files[0].profile.copy()
    out_profile.update({
        "height": mosaic_array.shape[1],
        "width": mosaic_array.shape[2],
        "transform": out_transform
    })

    # close individual files
    for src in intersecting_files:
        src.close()

    output_path = Path(output_dem_path)
    output_path.parent.mkdir(parents=True, exist_ok= True)

    with rasterio.open(output_path, "w", **out_profile) as dst: 
        dst.write(mosaic_array)

    print(f"Saved merged DEM to {output_path}")

    dem_src = rasterio.open(output_path)

    return dem_src



