# EXTRACT DATA
def extract_osm_data_bbox(north, south, east, west):
    """
    Downloads building and tree footprint geometries from OpenStreetMAp
    for a specified bounding box and prepares them for 3D processing.
    
    The data is reprojected from WGS84 (degrees) to EPSG:3763 (meters)
    to allow for a correct and accurate physical extrusion of a 3D model.
    
    Parameters:
    - north (float): Northern latitude of the bounding box
    - south (float): Southern latitude of the bounding box
    - east (float): Eastern longitude of the bounding box
    - west (float): Western longitude of the bounding box

    Returns:
    - buildings (GeoDataFrame)
    - trees (GeoDataFrame)
    - (center_x, center_y) (tuple of floats): coordinates in meteres, used to
        specify the region's origin for accurate placement in Cesium Ion
    """

    # Bounding box parameters
    bbox = [west, south, east, north]
    print("Downloading OSM data for bounding box...")

    # Query OSM for specific map features within the bounding box

    # Extract all building topologies (residential, commercial, etc)
    buildings = ox.features_from_bbox(bbox, tags={'building': True})

    # Extract individual tree nodes/polygons
    trees = ox.features_from_bbox(bbox, tags={'natural': 'tree'})

    # Project to local CRS (ESPG:3763 -> PT-TM06 / ETRS89 - Portugal's local coordinate system)
    # OSM data defaults to WGS84 (EPSG:4326), which uses degrees.
    # To extrude buildings in meters without distortion in 3D generation, the data is
    #projected to a metric coordinate system.
    buildings = ox.projection.project_gdf(buildings, to_crs="3763")
    trees = ox.projection.project_gdf(trees, to_crs="3763")

    print(f"Downloaded {len(buildings)} buildings and {len(trees)} trees.")

    minx, miny, maxx, maxy = buildings.total_bounds

    # Calculate geographic center based on the actual downloaded geometries
    # The extracted dataset center differs from the geographic center of the bounding
    # box used as input (we calculate this center after projecting to avoid non-linear 
    # distortion inherent in LAT/LON coordinates)

    center_x = (minx + maxx) / 2
    center_y = (miny + maxy) / 2

    return buildings, trees, (center_x, center_y)


def select_dem_files(north, south, west, east, dem_dir, output_dem_path):
    """
    Identifies, clips and merges DEM tiles that intersect the selected geographic
    bounding box to create a continuous elevation surface

    Parameters:
    - north (float): Northern latitude of the bounding box
    - south (float): Southern latitude of the bounding box
    - west (float): Western longitude of the bounding box
    - east (float): Eastern longitude of the bounding box
    - dem_dir (str or Path): Directory containing the source DEM .tiff files
    - output_dem_path (str or Path): File path to save the merged DEM files raster

    Returns:
    - dem_src (rasterio.DatasetReader): OPnened rasterio dataset of the merged DEM files 
    used downstream to query elevation data for placing buildings and trees

    """

    # Transform selected bounding box to local projection 
    transformer = Transformer.from_crs("EPSG:4326", "EPSG:3763", always_xy= True)
    min_x, min_y = transformer.transform(west, south)
    max_x, max_y = transformer.transform(east, north)
    bbox_polygon = box(min_x, min_y, max_x, max_y)

    # Select intersecting DEM files
    intersecting_files = []
    for path in Path(dem_dir).glob("*.tiff"):
        src = rasterio.open(path)
        print(f"\n--- Checking {path.name} ---")
        print(f"DEM CRS: {src.crs}")
        print(f"DEM Bounds: {src.bounds}")
        print(f"BBOX (EPSG:3763): {bbox_polygon.bounds}")

        # Create bounding box geometry for the current DEM tile
        dem_poly = box (src.bounds.left, src.bounds.bottom, src.bounds.right, src.bounds.top)

        if bbox_polygon.intersects(dem_poly):
            intersecting_files.append(src)
        else:
            src.close() # Free up memory for unused rasters

    if not intersecting_files:
        raise FileExistsError("No DEM files cover the selected bounding box")


    # Merge selected DEM files into a single array (easier to use, instead of iterating through all of them)
    print(f"Merging {len(intersecting_files)} matching DEM tile(s)")
    mosaic_array, out_transform = merge(intersecting_files)

    # Copy spatial profile (metadata) from the first tile to apply to the merged array
    # Rasterio's merge function outputs a raw NumPy array (no spatial reference)
    # The metadata is updated to restore its real-world coordinates and dimensions
    out_profile = intersecting_files[0].profile.copy()
    out_profile.update({
        "height": mosaic_array.shape[1],
        "width": mosaic_array.shape[2],
        "transform": out_transform
    })

    # Close individual source files
    for src in intersecting_files:
        src.close()

    # Save merged DEM to disk
    output_path = Path(output_dem_path)
    output_path.parent.mkdir(parents=True, exist_ok= True)

    with rasterio.open(output_path, "w", **out_profile) as dst: 
        dst.write(mosaic_array)

    print(f"Saved merged DEM to {output_path}")

    # Re-open the saved file to return a standard rasterio DatasetReader object
    dem_src = rasterio.open(output_path)

    return dem_src


