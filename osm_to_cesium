#Extract OSM data

def extract_osm_data_bbox(north, south, east, west):
    
    bbox = [west, south, east, north]

    print("Downloading OSM data for bounding box...")

    # Buildings
    buildings = ox.features_from_bbox(bbox,
        tags={'building': True}
    )

    # Streets
    streets = ox.graph_from_bbox(bbox,
        network_type='drive',
        simplify=False
    )
    #Trees
    trees = ox.features_from_bbox(bbox,
        tags={'natural':'tree'}
    )
    

    buildings = ox.projection.project_gdf(buildings)
    streets = ox.project_graph(streets)
    trees = ox.projection.project_gdf(trees)



    print(f"Downloaded {len(buildings)} buildings")
    print(f"Downloaded {len(streets.edges)} street segments")

    minx, miny, maxx, maxy = buildings.total_bounds
    center_x = (minx + maxx) / 2
    center_y = (miny + maxy) / 2

    return buildings, streets, trees, (center_x, center_y)

#Generate building footprints

def parse_height(value):
    if not value:
        return None
    try:
        return float(str(value).replace("m", "").split(";")[0])
    except:
        return None

def is_missing(value):
    return value is None or (isinstance(value, float) and np.isnan(value))

def generate_footprints(buildings):
    footprints = []

    for _, row in buildings.iterrows():
        geom = row.geometry

        # Extract height info once here
        height = parse_height(row.get('height'))
        levels = parse_height(row.get('building:levels'))

        if  is_missing(height) and not is_missing(levels):
            height = levels * 3  # 3m per floor

        if is_missing(height):
            # fallback
            height = random.uniform(3, 6)

        def add_poly(poly):
            footprints.append({
                "geometry": poly,
                "height": height
            })

        if isinstance(geom, MultiPolygon):
            for poly in geom.geoms:
                add_poly(poly)
        elif isinstance(geom, Polygon):
            add_poly(geom)

    return footprints



